def generar_recomendaciones_remocion(parches, direccion_viento='Norte', kml_data=None):
    recomendaciones = {
        'frentes_prioritarios': [],
        'orden_remocion': [],
        'estrategia': '',
        'detalles': [],
        'area_total_ha': sum(p['area_ha'] for p in parches) if parches else 0,
        'num_parches': len(parches) if parches else 0
    }
    
    if not parches:
        return recomendaciones
    
    if kml_data and 'poligono' in kml_data:
        frentes = generar_frentes_desde_kmz(kml_data)
    else:
        frentes = FRENTES_REMOCION_DEFECTO
    
    frentes_prioritarios = obtener_frentes_prioritarios(direccion_viento)
    recomendaciones['frentes_prioritarios'] = frentes_prioritarios
    
    area_por_frente = {}
    parches_por_frente = {}
    
    for nombre, frente in frentes.items():
        poligono = Polygon(frente['poligono'])
        area_frente = 0
        parches_frente = []
        for patch in parches:
            punto = Point(patch['lon'], patch['lat'])
            if poligono.contains(punto):
                area_frente += patch['area_ha']
                parches_frente.append(patch)
        area_por_frente[nombre] = area_frente
        parches_por_frente[nombre] = parches_frente
    
    orden_remocion = []
    for frente in frentes_prioritarios:
        if frente in area_por_frente and area_por_frente[frente] > 0:
            orden_remocion.append({
                'frente': frente,
                'area_ha': area_por_frente[frente],
                'parches': len(parches_por_frente[frente]),
                'prioridad': 'Alta',
                'razon': f'Zona de acumulación por viento {direccion_viento}'
            })
    
    frentes_restantes = [f for f in area_por_frente.keys() if f not in frentes_prioritarios]
    for frente in sorted(frentes_restantes, key=lambda x: area_por_frente[x], reverse=True):
        if area_por_frente[frente] > 0:
            prioridad = 'Media' if area_por_frente[frente] > 5 else 'Baja'
            orden_remocion.append({
                'frente': frente,
                'area_ha': area_por_frente[frente],
                'parches': len(parches_por_frente[frente]),
                'prioridad': prioridad,
                'razon': f'Área: {area_por_frente[frente]:.1f} ha'
            })
    
    recomendaciones['orden_remocion'] = orden_remocion
    
    if orden_remocion:
        total_area = sum(o['area_ha'] for o in orden_remocion)
        if total_area > 0:
            primer_frente = orden_remocion[0]['frente']
            area_primer = orden_remocion[0]['area_ha']
            if area_primer / total_area > 0.4:
                estrategia = f'⚠️ CONCENTRACIÓN CRÍTICA: {area_primer:.1f} ha en {primer_frente}'
            elif area_primer / total_area > 0.2:
                estrategia = f'📊 CONCENTRACIÓN MODERADA: {area_primer:.1f} ha en {primer_frente}'
            else:
                estrategia = f'✅ DISTRIBUCIÓN UNIFORME: Priorizar {primer_frente}'
            recomendaciones['estrategia'] = estrategia
    
    for f in orden_remocion[:3]:
        recomendaciones['detalles'].append(
            f"{'⭐' if f['frente'] in frentes_prioritarios else '📌'} "
            f"{f['frente']}: {f['area_ha']:.1f} ha ({f['parches']} parches) - Prioridad {f['prioridad']}"
        )
    
    return recomendaciones

