class SimuladorLirio:
    def __init__(self, area_embalse_ha=5000, seed=42):
        np.random.seed(seed)
        self.area_embalse = area_embalse_ha
        self.area_inicial = area_embalse_ha * np.random.uniform(0.02, 0.05)
        
    def simular_crecimiento(self, mes='Mayo', dias=30, area_actual_ha=None):
        clima = CLIMA_DATABASE.get(mes)
        if clima is None:
            clima = {'temp': 25.0, 'humedad': 80.0, 'radiacion': 700.0,
                     'velocity': 2.0, 'precipitacion': 50.0, 'tasa_crecimiento': 0.45,
                     'direccion_viento': 'Norte'}
        
        if area_actual_ha is not None:
            self.area_inicial = area_actual_ha
        
        factor_temp = max(0.3, min(1.0, (clima['temp'] - 10) / 25))
        factor_radiacion = max(0.3, min(1.0, clima['radiacion'] / 1000))
        factor_humedad = max(0.3, min(1.0, clima['humedad'] / 85))
        
        tasa_base = clima.get('tasa_crecimiento', 0.45)
        tasa_ajustada = tasa_base * (0.4 * factor_temp + 0.3 * factor_radiacion + 0.3 * factor_humedad)
        
        capacidad_carga = self.area_embalse * 0.3
        
        areas = []
        for dia in range(dias + 1):
            r = tasa_ajustada / 100
            K = capacidad_carga
            area = K / (1 + ((K - self.area_inicial) / self.area_inicial) * np.exp(-r * dia))
            areas.append(min(area, capacidad_carga))
        
        return {
            'dias': list(range(dias + 1)),
            'areas': areas,
            'area_inicial': areas[0],
            'area_final': areas[-1],
            'tasa_diaria': tasa_ajustada,
            'crecimiento_ha': areas[-1] - areas[0],
            'crecimiento_pct': ((areas[-1] / areas[0]) - 1) * 100,
            'clima': clima,
            'mes': mes,
            'capacidad_carga': capacidad_carga,
            'direccion_viento': clima.get('direccion_viento', 'Norte')
        }
    
    def generar_parches(self, area_total, kml_data=None):
        num_parches = np.random.randint(15, 35)
        areas = np.random.pareto(1.5, num_parches)
        areas = areas / areas.sum() * area_total
        areas = np.maximum(areas, 0.1)
        
        parches = []
        
        if kml_data and 'poligono' in kml_data:
            poligono = kml_data['poligono']
            lats = [p[0] for p in poligono]
            lons = [p[1] for p in poligono]
            lat_min, lat_max = min(lats), max(lats)
            lon_min, lon_max = min(lons), max(lons)
            
            for i in range(num_parches):
                intentos = 0
                while intentos < 50:
                    lat = np.random.uniform(lat_min + 0.002, lat_max - 0.002)
                    lon = np.random.uniform(lon_min + 0.002, lon_max - 0.002)
                    if punto_en_poligono(lat, lon, poligono):
                        break
                    intentos += 1
                
                if areas[i] > area_total * 0.12:
                    prioridad = 1
                elif areas[i] > area_total * 0.06:
                    prioridad = 2
                else:
                    prioridad = 3
                
                parches.append({
                    'id': i + 1,
                    'area_ha': areas[i],
                    'lat': lat,
                    'lon': lon,
                    'prioridad': prioridad,
                    'distancia_aproximada_km': np.random.uniform(0.3, 4.0)
                })
        else:
            for i in range(num_parches):
                lat = 20.08 + np.random.uniform(-0.04, 0.04)
                lon = -101.08 + np.random.uniform(-0.04, 0.04)
                
                if areas[i] > area_total * 0.12:
                    prioridad = 1
                elif areas[i] > area_total * 0.06:
                    prioridad = 2
                else:
                    prioridad = 3
                
                parches.append({
                    'id': i + 1,
                    'area_ha': areas[i],
                    'lat': lat,
                    'lon': lon,
                    'prioridad': prioridad,
                    'distancia_aproximada_km': np.random.uniform(0.3, 4.0)
                })
        
        return sorted(parches, key=lambda x: x['area_ha'], reverse=True)

class OptimizadorFlota:
    def __init__(self):
        self.banda_capacidad = 5.0
        self.banda_costo = 5000.0
        self.camion_capacidad = 14.0
        self.camion_costo = 2000.0
        self.tractor_costo = 8000.0
        self.personal_costo = 12000.0
        
    def optimizar(self, area_ha, prioridad='balanceado'):
        volumen = area_ha * 1000
        opciones = []
        
        for bandas in range(1, 8):
            capacidad = bandas * self.banda_capacidad
            dias = max(1, area_ha / capacidad)
            viajes = volumen / self.camion_capacidad
            camiones = max(2, int(np.ceil(viajes / (dias * 4))))
            tractores = max(1, int(np.ceil(bandas / 2)))
            personal = bandas * 2 + camiones * 1 + tractores * 1
            
            costo_bandas = bandas * self.banda_costo * dias
            costo_camiones = camiones * self.camion_costo * dias
            costo_tractores = tractores * self.tractor_costo * dias
            costo_personal = personal * self.personal_costo * dias
            costo_total = costo_bandas + costo_camiones + costo_tractores + costo_personal
            eficiencia = (capacidad / (area_ha / max(1, dias))) * 100
            
            if prioridad == 'tiempo':
                score = 1 / dias
            elif prioridad == 'costo':
                score = 1 / costo_total
            else:
                score = 0.4 * (1 / dias) + 0.4 * (1 / costo_total) + 0.2 * (eficiencia / 100)
            
            opciones.append({
                'bandas': bandas,
                'camiones': camiones,
                'tractores': tractores,
                'personal': personal,
                'dias': dias,
                'costo_total': costo_total,
                'capacidad_diaria': capacidad,
                'eficiencia': eficiencia,
                'score': score
            })
        
        mejor = max(opciones, key=lambda x: x['score'])
        
        return {
            'mejor': mejor,
            'opciones': opciones,
            'volumen_m3': volumen,
            'area_ha': area_ha
        }

