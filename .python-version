def cargar_archivo_geometrico(archivo):
    try:
        contenido = archivo.read()
        if archivo.name.endswith('.kmz'):
            return procesar_kmz(contenido)
        else:
            return procesar_kml(contenido)
    except Exception as e:
        return {'error': str(e)}

def procesar_kmz(contenido):
    try:
        with zipfile.ZipFile(io.BytesIO(contenido)) as z:
            kml_files = [f for f in z.namelist() if f.endswith('.kml')]
            if not kml_files:
                return {'error': 'No se encontró archivo KML dentro del KMZ'}
            with z.open(kml_files[0]) as kml_file:
                kml_content = kml_file.read()
        return procesar_kml(kml_content)
    except zipfile.BadZipFile:
        return {'error': 'El archivo no es un KMZ válido'}

def procesar_kml(contenido):
    try:
        root = ET.fromstring(contenido)
        ns = {'kml': 'http://www.opengis.net/kml/2.2'}
        coords_elements = root.findall('.//kml:coordinates', ns)
        if not coords_elements:
            coords_elements = root.findall('.//coordinates')
        if not coords_elements:
            coords_elements = root.findall('.//kml:Polygon//kml:coordinates', ns)
        if coords_elements:
            coords_text = coords_elements[0].text.strip()
            points = []
            for coord in coords_text.split():
                parts = coord.strip().split(',')
                if len(parts) >= 2:
                    lon = float(parts[0])
                    lat = float(parts[1])
                    points.append([lat, lon])
            if points:
                lat_center = sum(p[0] for p in points) / len(points)
                lon_center = sum(p[1] for p in points) / len(points)
                lats = [p[0] for p in points]
                lons = [p[1] for p in points]
                return {
                    'poligono': points,
                    'centro': [lat_center, lon_center],
                    'puntos': len(points),
                    'bbox': [min(lats), min(lons), max(lats), max(lons)],
                    'area_km2': calcular_area_poligono(points),
                    'area_ha': calcular_area_poligono(points) * 100
                }
        return {'error': 'No se encontraron coordenadas en el KML'}
    except Exception as e:
        return {'error': str(e)}

def calcular_area_poligono(points):
    n = len(points)
    area = 0
    for i in range(n):
        j = (i + 1) % n
        lat1, lon1 = points[i]
        lat2, lon2 = points[j]
        area += (lon2 * 111.32 * math.cos(math.radians(lat1))) * (lat2 - lat1) * 111.32
    return abs(area) / 2

