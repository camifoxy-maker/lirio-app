    def descargar_bandas(self, item):
        """Descarga las bandas necesarias de la imagen"""
        if item.get('simulado', False):
            # Generar imagen sintética de 256x256
            h, w = 256, 256
            descargas = {}
            
            # Crear un patrón de lago
            y, x = np.ogrid[:h, :w]
            cy, cx = h//2, w//2
            lago = ((y-cy)**2/(h*0.35)**2 + (x-cx)**2/(w*0.35)**2) < 1
            
            # Agregar parches de lirio con diferentes tamaños
            np.random.seed(42)
            lirio = np.zeros((h, w), dtype=bool)
            
            # Número de parches según el mes (más en verano)
            mes_num = item.get('mes_numero', 5)
            if mes_num in [3, 4, 5]:  # Primavera
                num_parches = np.random.randint(12, 20)
            elif mes_num in [6, 7, 8]:  # Verano
                num_parches = np.random.randint(8, 15)
            else:
                num_parches = np.random.randint(5, 12)
            
            for _ in range(num_parches):
                lx = np.random.randint(20, w-20)
                ly = np.random.randint(20, h-20)
                r = np.random.randint(8, 30)
                patch = ((y-ly)**2 + (x-lx)**2) < r**2
                lirio = lirio | (patch & lago)
            
            # Generar bandas
            for banda in ['B4', 'B5', 'B6', 'B2', 'B3']:
                arr = np.random.uniform(500, 2000, (h, w))
                
                # Simular agua y lirio
                if banda == 'B5':  # NIR
                    arr[lago] = np.random.uniform(300, 800, np.sum(lago))
                    arr[lirio] = np.random.uniform(2000, 4500, np.sum(lirio))
                elif banda == 'B4':  # Red
                    arr[lago] = np.random.uniform(200, 600, np.sum(lago))
                    arr[lirio] = np.random.uniform(300, 500, np.sum(lirio))
                elif banda == 'B6':  # SWIR
                    arr[lago] = np.random.uniform(100, 400, np.sum(lago))
                    arr[lirio] = np.random.uniform(1000, 2000, np.sum(lirio))
                elif banda == 'B3':  # Green
                    arr[lago] = np.random.uniform(300, 700, np.sum(lago))
                    arr[lirio] = np.random.uniform(400, 600, np.sum(lirio))
                else:  # Blue
                    arr[lago] = np.random.uniform(200, 600, np.sum(lago))
                    arr[lirio] = np.random.uniform(300, 500, np.sum(lirio))
                
                arr = np.clip(arr, 0, 10000).astype(np.uint16)
                descargas[banda] = arr
            
            # Guardar máscara para calcular área
            descargas['mask_lirio'] = lirio
            descargas['area_ha'] = np.sum(lirio) * 30 * 30 / 10000  # 30m pixel
            
            return descargas
        
        return None

# ============================================================================
# PROCESAR IMAGEN LANDSAT
# ============================================================================

def procesar_imagen_landsat(descargas, kml_data):
    """Procesa las bandas descargadas y detecta lirio (Landsat)"""
    
    if not descargas or len(descargas) < 3:
        return None
    
    try:
        # Para simulación, las bandas ya son arrays de numpy
        if isinstance(descargas.get('B4'), np.ndarray):
            red = descargas['B4'].astype(np.float32)
            nir = descargas['B5'].astype(np.float32)
            swir = descargas['B6'].astype(np.float32)
            blue = descargas['B2'].astype(np.float32)
            green = descargas['B3'].astype(np.float32)
            
            h, w = red.shape
            
            # Normalizar
            red = np.clip(red / 10000.0, 0, 1)
            nir = np.clip(nir / 10000.0, 0, 1)
            swir = np.clip(swir / 10000.0, 0, 1)
            blue = np.clip(blue / 10000.0, 0, 1)
            green = np.clip(green / 10000.0, 0, 1)
            
            # Calcular índices
            denom = (nir + red)
            denom[denom == 0] = 1e-5
            ndvi = (nir - red) / denom
            ndvi = np.clip(ndvi, -1, 1)
            
            # FAI para Landsat
            lambda_factor = (865.0 - 660.0) / (1610.0 - 660.0)
            fai = nir - (red + (swir - red) * lambda_factor)
            
            denom_ndwi = (green + nir)
            denom_ndwi[denom_ndwi == 0] = 1e-5
            ndwi = (green - nir) / denom_ndwi
            ndwi = np.clip(ndwi, -1, 1)
            
            # Detectar lirio
            mask_agua = ndwi > 0.1
            mask_lirio = (ndvi > 0.25) & (fai > 0.03) & mask_agua
            
            # Si hay máscara de lirio de la simulación, usarla
            if 'mask_lirio' in descargas:
                mask_lirio = descargas['mask_lirio']
            
            # Calcular área
            pixel_area = 30 * 30  # Landsat 30m
            area_m2 = np.sum(mask_lirio) * pixel_area
            area_ha = area_m2 / 10000
            
            # Generar parches
            from scipy.ndimage import label, center_of_mass
            
            labeled, num_patches = label(mask_lirio)
            parches = []
            
            for i in range(1, num_patches + 1):
                patch_mask = labeled == i
                patch_pixels = np.sum(patch_mask)
                patch_area_ha = (patch_pixels * pixel_area) / 10000
                
                if patch_area_ha > 0.01:
                    centroid = center_of_mass(patch_mask)
                    lat = 20.08 + (centroid[0] / h - 0.5) * 0.08
                    lon = -101.08 + (centroid[1] / w - 0.5) * 0.08
                    
                    if patch_area_ha > 5:
                        prioridad = 1
                    elif patch_area_ha > 2:
                        prioridad = 2
                    else:
                        prioridad = 3
                    
                    parches.append({
                        'id': i,
                        'area_ha': patch_area_ha,
                        'lat': lat,
                        'lon': lon,
                        'prioridad': prioridad,
                        'distancia_aproximada_km': np.random.uniform(0.3, 4.0)
                    })
            
            return {
                'area_ha': area_ha,
                'parches': sorted(parches, key=lambda x: x['area_ha'], reverse=True),
                'ndvi': ndvi,
                'fai': fai,
                'ndwi': ndwi,
                'mask_lirio': mask_lirio,
                'num_parches': num_patches,
                'pixeles': int(np.sum(mask_lirio)),
                'resolucion': '30m (Landsat)'
            }
        
        return None
        
    except Exception as e:
        st.error(f"❌ Error al procesar imagen: {e}")
        return None

