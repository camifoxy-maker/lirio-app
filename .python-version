def mostrar_graficos(crecimiento, parches, escenarios):
    fig = make_subplots(
        rows=2, cols=2,
        subplot_titles=('📈 Crecimiento del Lirio', '📊 Distribución de Parches',
                       '🚜 Comparativa de Escenarios', '🌡️ Factores Climáticos'),
        specs=[[{'secondary_y': False}, {'secondary_y': False}],
               [{'secondary_y': True}, {'secondary_y': False}]]
    )
    
    fig.add_trace(
        go.Scatter(
            x=crecimiento['dias'],
            y=crecimiento['areas'],
            mode='lines+markers',
            name='Área de lirio',
            line=dict(color='#2e86c1', width=3),
            marker=dict(size=6)
        ),
        row=1, col=1
    )
    
    fig.add_hline(
        y=crecimiento['capacidad_carga'],
        line_dash="dash",
        line_color="red",
        annotation_text="Capacidad de carga",
        row=1, col=1
    )
    
    if parches:
        areas = [p['area_ha'] for p in parches]
        fig.add_trace(
            go.Histogram(
                x=areas,
                nbinsx=20,
                name='Distribución',
                marker_color='#2e86c1',
                opacity=0.7
            ),
            row=1, col=2
        )
    
    if escenarios:
        df_esc = pd.DataFrame(escenarios)
        fig.add_trace(
            go.Scatter(
                x=df_esc['bandas'],
                y=df_esc['dias'],
                mode='lines+markers',
                name='Días',
                line=dict(color='#2e86c1')
            ),
            row=2, col=1
        )
        fig.add_trace(
            go.Scatter(
                x=df_esc['bandas'],
                y=df_esc['costo_total'] / 1000000,
                mode='lines+markers',
                name='Costo (M MXN)',
                line=dict(color='#dc3545')
            ),
            secondary_y=True,
            row=2, col=1
        )
    
    clima = crecimiento['clima']
    categorias = ['Temperatura', 'Humedad', 'Radiación', 'Viento']
    valores = [clima['temp'], clima['humedad'], clima['radiacion'], clima['velocity']]
    colores = ['#dc3545', '#2e86c1', '#ffc107', '#28a745']
    
    fig.add_trace(
        go.Bar(
            x=categorias,
            y=valores,
            name='Factores',
            marker_color=colores,
            text=[f"{v:.1f}" for v in valores],
            textposition='auto'
        ),
        row=2, col=2
    )
    
    fig.update_layout(
        height=600,
        showlegend=True,
        template='plotly_white'
    )
    
    fig.update_xaxes(title_text="Días", row=1, col=1)
    fig.update_yaxes(title_text="Área (ha)", row=1, col=1)
    fig.update_xaxes(title_text="Área (ha)", row=1, col=2)
    fig.update_yaxes(title_text="Frecuencia", row=1, col=2)
    fig.update_xaxes(title_text="Bandas", row=2, col=1)
    fig.update_yaxes(title_text="Días", row=2, col=1)
    fig.update_yaxes(title_text="Costo (M MXN)", secondary_y=True, row=2, col=1)
    fig.update_xaxes(title_text="Factor", row=2, col=2)
    fig.update_yaxes(title_text="Valor", row=2, col=2)
    
    st.plotly_chart(fig, use_container_width=True)

def mostrar_mapa_y_recomendaciones(parches, direccion_viento='Norte', kml_data=None, satelite_data=None):
    if not parches:
        st.info("ℹ️ No hay datos suficientes para generar el mapa")
        return
    
    col1, col2 = st.columns([2, 1])
    
    with col1:
        st.markdown("### 🗺️ Frentes de Remoción - Presa Yuriria")
        m = crear_mapa_yuriria(parches, direccion_viento, kml_data, satelite_data)
        
        with tempfile.NamedTemporaryFile(delete=False, suffix='.html') as tmp:
            m.save(tmp.name)
            with open(tmp.name, 'r', encoding='utf-8') as f:
                html = f.read()
            st.components.v1.html(html, height=500)
        
        try:
            os.unlink(tmp.name)
        except:
            pass
    
    with col2:
        st.markdown("### 📋 Plan de Remoción")
        rec = generar_recomendaciones_remocion(parches, direccion_viento, kml_data)
        
        st.markdown(f"""
        <div style="background: #f8f9fa; padding: 12px; border-radius: 8px; border-left: 4px solid #2e86c1; margin: 8px 0;">
            <b>🎯 Estrategia</b><br>{rec['estrategia']}
        </div>
        """, unsafe_allow_html=True)
        
        st.markdown("**📊 Orden de Remoción:**")
        for i, f in enumerate(rec['orden_remocion'][:5], 1):
            if f['prioridad'] == 'Alta':
                icono = '🔴'
                bg = '#f8d7da'
            elif f['prioridad'] == 'Media':
                icono = '🟡'
                bg = '#fff3cd'
            else:
                icono = '🟢'
                bg = '#d4edda'
            
            st.markdown(f"""
            <div style="background: {bg}; padding: 6px 10px; border-radius: 6px; margin: 3px 0; display: flex; justify-content: space-between; font-size: 0.85rem;">
                <span><b>{i}.</b> {icono} <b>{f['frente']}</b></span>
                <span>{f['area_ha']:.1f} ha</span>
            </div>
            """, unsafe_allow_html=True)
        
        st.markdown(f"""
        <div style="background: #e8f4f8; padding: 8px 12px; border-radius: 6px; margin: 8px 0; border: 1px solid #2e86c1;">
            <b>💨 Viento: {direccion_viento}</b><br>
            <span style="font-size: 0.8rem; color: #2c3e50;">
                Frentes prioritarios: {', '.join(rec['frentes_prioritarios'])}
            </span>
        </div>
        """, unsafe_allow_html=True)

